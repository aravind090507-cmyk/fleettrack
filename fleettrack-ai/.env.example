# =============================================================================
# FleetTrack AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fleettrack:fleettrack_secret@localhost:5432/fleettrack_db
# PostGIS is automatically enabled in the Docker Compose setup.

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- GPS Device Authentication ---
# Shared secret used by GPS devices to authenticate location submissions.
# Generate with: openssl rand -hex 32
GPS_DEVICE_AUTH_SECRET=CHANGE_ME_gps_device_shared_secret

# --- Google Maps ---
# Browser-restricted key (used in frontend, safe to include in JS bundle)
# Enable: Maps JavaScript API, Places API
VITE_GOOGLE_MAPS_BROWSER_KEY=YOUR_GOOGLE_MAPS_BROWSER_API_KEY

# Server-side key (used in backend only, NEVER expose to frontend)
# Enable: Directions API, Routes API, Geocoding API
GOOGLE_MAPS_SERVER_KEY=YOUR_GOOGLE_MAPS_SERVER_API_KEY

# --- AI Provider ---
# Supported providers: openai, gemini, anthropic, none
# Set to "none" to use rule-based fallback (no API key required)
AI_PROVIDER=none
AI_API_KEY=YOUR_AI_API_KEY_HERE
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis (optional, for WebSocket scaling) ---
# Leave empty to use in-memory pub/sub (suitable for single-instance dev)
REDIS_URL=

# --- Application ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL (used by Docker Compose) ---
POSTGRES_USER=fleettrack
POSTGRES_PASSWORD=fleettrack_secret
POSTGRES_DB=fleettrack_db
