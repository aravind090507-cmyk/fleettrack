# Corporate Fleet Tracking & Geospatial Navigation Environment Configuration

# --- Application Domain ---
DOMAIN_NAME=yourdomain.com
# For Vercel: set BASE_URL to your deployment URL (e.g. https://your-app.vercel.app)
BASE_URL=https://yourdomain.com
APP_ENVIRONMENT=production

# --- Database ---
# Local Docker Compose (PostgreSQL 16 + PostGIS 3.4):
POSTGRES_DB=fleettrack
POSTGRES_USER=fleet
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
DATABASE_URL=postgresql+asyncpg://fleet:CHANGE_THIS_TO_A_SECURE_PASSWORD@postgres:5432/fleettrack
# Vercel + Neon (use this form instead):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# --- In-Memory Cache & Message Broker (Redis 7) ---
REDIS_URL=redis://redis:6379/0

# --- JWT Cryptographic Security ---
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Ephemeral Journey Tracking Link Hard Limit ---
TRACKING_LINK_EXPIRE_HOURS=24

# --- GPS Telemetry Ingestion Thresholds ---
GPS_MAX_ACCURACY_METERS=50.0
GPS_MAX_SPEED_KMH=180.0

# --- CORS Allowed Origins (JSON Array) ---
CORS_ORIGINS=["https://yourdomain.com","http://localhost:5173"]
