# ==============================================================================
# FLEETTRACK AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Backend (Railway Service) ---
PORT=8000
APP_ENVIRONMENT=production

# Railway PostgreSQL URL (Automatically provided when attaching PostgreSQL on Railway):
# Example: postgresql://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Railway Redis URL (Automatically provided when attaching Redis on Railway):
# Example: redis://default:password@redis.railway.internal:6379
REDIS_URL=redis://default:password@redis.railway.internal:6379

# JWT Cryptographic Secret (Generate using: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ephemeral Public Tracking Link Expiry (Hours)
TRACKING_LINK_EXPIRE_HOURS=24

# Allowed CORS Origins (Include your Vercel frontend URL)
CORS_ORIGINS=["https://fleettrack.vercel.app","http://localhost:5173"]

# GPS Validation Thresholds
GPS_MAX_ACCURACY_METERS=120.0
GPS_MAX_SPEED_KMH=220.0

# --- Frontend (Vercel Project) ---
# Configure these in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://fleettrack-backend.up.railway.app
# VITE_WS_URL=wss://fleettrack-backend.up.railway.app
