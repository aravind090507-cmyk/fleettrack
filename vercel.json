{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fleettrack-production-d254.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://fleettrack-production-d254.up.railway.app/health"
    },
    {
      "source": "/docs",
      "destination": "https://fleettrack-production-d254.up.railway.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://fleettrack-production-d254.up.railway.app/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
