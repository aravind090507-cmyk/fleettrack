# FleetTrack Frontend Environment Variables (Vercel)
# Replace with your deployed Railway FastAPI backend URL:
VITE_API_URL=https://fleettrack-backend.up.railway.app
VITE_WS_URL=wss://fleettrack-backend.up.railway.app
# Mapbox token for high-res vector retina maps:
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
