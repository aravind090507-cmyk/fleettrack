# Database — defaults to SQLite for local zero-dependency testing
DATABASE_URL=sqlite+aiosqlite:///./fleettrack.db

# In production with PostgreSQL and PostGIS:
# DATABASE_URL=postgresql+asyncpg://fleet:fleetpass@localhost:5432/fleettrack

# Redis Cache and Pub/Sub
REDIS_URL=redis://localhost:6379/0

# JWT Cryptography
SECRET_KEY=a3f8e2c1d9b047a6f3e8c2d1b9a047f6e3c8d2b1a9047f6e3c8d2b1a9047f6e3
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Tracking Link Hard Expiration (Hours)
TRACKING_LINK_EXPIRE_HOURS=24
BASE_URL=http://localhost:5173

# GPS Telemetry Thresholds
GPS_MAX_ACCURACY_METERS=50.0
GPS_MAX_SPEED_KMH=180.0

# Environment
APP_ENVIRONMENT=development
